{
  "info": {
    "name": "Franchise API",
    "description": "Coleccion de pruebas de la API de franquicias. Ejecutar en orden (Runner): cada peticion guarda los IDs en variables de coleccion para las siguientes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "franchiseId", "value": "" },
    { "key": "branchId", "value": "" },
    { "key": "branch2Id", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "product2Id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('API arriba', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('UP'); });"
      ] } }]
    },
    {
      "name": "1. Franquicias",
      "item": [
        {
          "name": "Crear franquicia",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Franquicia Postman\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.test('Devuelve id y nombre', () => { pm.expect(b.id).to.be.a('string'); pm.expect(b.name).to.eql('Franquicia Postman'); });",
            "pm.collectionVariables.set('franchiseId', b.id);"
          ] } }]
        },
        {
          "name": "Actualizar nombre de franquicia",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Franquicia Postman Renombrada\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Nombre actualizado', () => pm.expect(pm.response.json().name).to.eql('Franquicia Postman Renombrada'));"
          ] } }]
        }
      ]
    },
    {
      "name": "2. Sucursales",
      "item": [
        {
          "name": "Agregar sucursal Norte",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sucursal Norte\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('branchId', pm.response.json().id);"
          ] } }]
        },
        {
          "name": "Agregar sucursal Sur",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sucursal Sur\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('branch2Id', pm.response.json().id);"
          ] } }]
        },
        {
          "name": "Actualizar nombre de sucursal",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sucursal Norte Centro\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Nombre actualizado', () => pm.expect(pm.response.json().name).to.eql('Sucursal Norte Centro'));"
          ] } }]
        }
      ]
    },
    {
      "name": "3. Productos",
      "item": [
        {
          "name": "Agregar producto Cafe (Norte)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cafe\",\n  \"stock\": 10\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('productId', pm.response.json().id);"
          ] } }]
        },
        {
          "name": "Agregar producto Te (Norte)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Te\",\n  \"stock\": 50\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('product2Id', pm.response.json().id);"
          ] } }]
        },
        {
          "name": "Agregar producto Pan (Sur)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branch2Id}}/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Pan\",\n  \"stock\": 5\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));"
          ] } }]
        },
        {
          "name": "Modificar stock de producto",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}/products/{{productId}}/stock",
            "body": { "mode": "raw", "raw": "{\n  \"stock\": 99\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Stock actualizado', () => pm.expect(pm.response.json().stock).to.eql(99));"
          ] } }]
        },
        {
          "name": "Actualizar nombre de producto",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}/products/{{productId}}",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Cafe Premium\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Nombre actualizado', () => pm.expect(pm.response.json().name).to.eql('Cafe Premium'));"
          ] } }]
        },
        {
          "name": "Eliminar producto Te",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}/products/{{product2Id}}"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));"
          ] } }]
        }
      ]
    },
    {
      "name": "4. Consultas",
      "item": [
        {
          "name": "Producto con mas stock por sucursal",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/top-stock-products" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const list = pm.response.json();",
            "pm.test('Un producto por sucursal', () => pm.expect(list.length).to.eql(2));",
            "pm.test('Cada item indica su sucursal', () => list.forEach(i => { pm.expect(i.branchId).to.be.a('string'); pm.expect(i.branchName).to.be.a('string'); }));",
            "const norte = list.find(i => i.branchId === pm.collectionVariables.get('branchId'));",
            "pm.test('Norte: Cafe Premium con 99', () => { pm.expect(norte.productName).to.eql('Cafe Premium'); pm.expect(norte.stock).to.eql(99); });"
          ] } }]
        },
        {
          "name": "Consultar franquicia completa",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/franchises/{{franchiseId}}" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Tiene 2 sucursales', () => pm.expect(pm.response.json().branches.length).to.eql(2));"
          ] } }]
        }
      ]
    },
    {
      "name": "5. Casos de error",
      "item": [
        {
          "name": "Franquicia inexistente (404)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/franchises/no-existe" },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404', () => pm.response.to.have.status(404));",
            "pm.test('Mensaje de error', () => pm.expect(pm.response.json().error).to.include('no encontrada'));"
          ] } }]
        },
        {
          "name": "Producto en sucursal inexistente (404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/no-existe/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"X\",\n  \"stock\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404', () => pm.response.to.have.status(404));"
          ] } }]
        },
        {
          "name": "Stock negativo (400)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises/{{franchiseId}}/branches/{{branchId}}/products/{{productId}}/stock",
            "body": { "mode": "raw", "raw": "{\n  \"stock\": -1\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));"
          ] } }]
        },
        {
          "name": "Nombre vacio (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/franchises",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));"
          ] } }]
        }
      ]
    }
  ]
}
